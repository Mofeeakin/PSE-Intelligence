# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=django-dev-secret-key-change-in-production-abc123xyz

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_NAME=pse_compliance
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ── LLM provider  (mock | openai | anthropic | deepseek) ─────────────────────
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# ── Monitoring ────────────────────────────────────────────────────────────────
# Grafana admin password  (default: admin — change before exposing externally)
GRAFANA_PASSWORD=admin

# ── Optional overrides ────────────────────────────────────────────────────────
# Additional CORS origins accepted by Django (comma-separated)
CORS_ALLOWED_ORIGINS_EXTRA=
